<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/playlist_widget_background"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/playlistWidgetTiles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/playlistWidgetEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/playlist_widget_empty"
        android:textColor="@color/playlist_widget_on_tile"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
