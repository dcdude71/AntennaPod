<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlistWidgetTile"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_margin="3dp"
    android:layout_weight="1"
    android:background="@drawable/playlist_widget_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/playlist_widget_button"
        android:importantForAccessibility="no"
        android:padding="7dp"
        android:src="@drawable/ic_playlist_widget_play" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/playlistWidgetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/playlist_widget_on_tile"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playlistWidgetSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/playlist_widget_on_tile"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
